# Copy to .env for local dev. Never commit the real .env.
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

# Leave unset locally to use SQLite. In prod set the Postgres URL:
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Currency conversion (Frankfurter is free, no key needed)
FX_PROVIDER_URL=https://api.frankfurter.dev/v1

# Optional: enables the "explain my balance" LLM feature
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8
